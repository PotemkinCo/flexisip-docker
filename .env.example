# Environment for docker compose.
# Copy to .env and adjust before first run.

# --- Public IP (required) ------------------------------------------------
# Your server's public IP address.  Used for:
#   - SIP TLS signaling (proxy listens on this IP)
#   - Let's Encrypt IP-certificate via HTTP-01 challenge (port 80 required)
SIP_IP=203.0.113.10

# --- TURN (coturn) — change from defaults ---------------------------------
# Public IP of the host running coturn (for the external-ip directive).
TURN_PUBLIC_IP=203.0.113.10
TURN_REALM=sip.example.com
TURN_USER=replace-with-random-turn-user
TURN_PASSWORD=replace-with-random-turn-password

# --- MariaDB credentials (required) ---------------------------------------
# These values are used by the MariaDB container on first initialization and
# by the conference configuration. Keep .env local and mode 600.
MARIADB_ROOT_PASSWORD=replace-with-random-root-password
MARIADB_PASSWORD=replace-with-random-conference-db-password
